+/*
+ * Policy "AMFI" syscalls. dyld asks op 0x5a (amfi_check_dyld_policy_self,
+ * arg -> {u64 in_flags; u64 *out_flags}) which DYLD_* variables to honour;
+ * on failure it honours none, so DYLD_INSERT_LIBRARIES (sweetenv) was
+ * ignored. Allow @paths, path variables, fallback paths, print variables,
+ * failed insertions (a bad dylib must not kill backboardd) and interposing.
+ * Other ops fail as before (no policy).
+ */
+#define SWEET_AMFI_DYLD_FLAGS   0x7bull
+
+static int
+sweet_amfi_syscall(__unused struct proc *p, int call, user_addr_t arg)
+{
+	uint64_t a[2], flags = SWEET_AMFI_DYLD_FLAGS;
+
+	if (call != 0x5a) {
+		return ENOPOLICY;
+	}
+	if (copyin(arg, a, sizeof(a)) != 0 || a[1] == 0) {
+		return EFAULT;
+	}
+	return copyout(&flags, (user_addr_t)a[1], sizeof(flags));
+}
