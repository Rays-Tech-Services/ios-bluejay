+/*
+ * sweetcpu_mhz=1: estimate each core's clock without touching clock or PMU
+ * registers. A chain of dependent ADDs retires one per cycle on the A55,
+ * A76 and X1, timed with the architected counter. Runs 20 s, 60 s and
+ * 120 s after the CPUs start (DVFS left by the bootloader may change).
+ */
+static uint64_t
+sweet_cpu_add_chain(uint64_t iterations)
+{
+	uint64_t v = 0;
+	for (uint64_t i = 0; i < iterations; i++) {
+		__asm__ volatile(
+			".rept 256\n\tadd %0, %0, #1\n\t.endr"
+			: "+r"(v));
+	}
+	return v;
+}
+
+static void
+sweet_cpu_measure(void *arg __unused, wait_result_t result __unused)
+{
+	static const uint32_t delays_s[] = { 20, 40, 60 };
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	for (unsigned int round = 0; round < sizeof(delays_s) / sizeof(delays_s[0]); round++) {
+		IOSleep(delays_s[round] * 1000);
+		for (unsigned int i = 0; i < topology->num_cpus; i++) {
+			thread_bind(cpu_to_processor((int)i));
+			IOSleep(1);     /* block: resume on the bound processor */
+			if (cpu_number() != (int)i) {
+				IOLog("SWEET MHZ: cpu %u bind failed\n", i);
+				continue;
+			}
+			sweet_cpu_add_chain(4096);      /* warm up */
+			uint64_t iterations = 16384;    /* 4M adds: ~1.5-2.5 ms at 1.8-2.8 GHz */
+			boolean_t intr = ml_set_interrupts_enabled(FALSE);
+			uint64_t t0 = mach_absolute_time();
+			sweet_cpu_add_chain(iterations);
+			uint64_t t1 = mach_absolute_time();
+			ml_set_interrupts_enabled(intr);
+			uint64_t ns;
+			absolutetime_to_nanoseconds(t1 - t0, &ns);
+			uint64_t mhz = ns ? iterations * 256 * 1000 / ns : 0;
+			IOLog("SWEET MHZ: round %u cpu %u mpidr 0x%x ~%llu MHz\n", round, i,
+			    topology->cpus[i].phys_id, mhz);
+		}
+		thread_bind(PROCESSOR_NULL);
+	}
+	thread_terminate(current_thread());
+}
