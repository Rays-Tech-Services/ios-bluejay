+_Static_assert(DMA_UCD + sizeof(struct ucd) <= DMA_BOUNCE, "UCD overlaps the bounce buffer");
 #define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
 
 static struct {
@@ -109,6 +123,9 @@ static struct {
 	bool writable;                          /* boot-arg ufsrw=1 */
 	bool cache;                             /* boot-arg ufscache=1 */
 	bool wait;                              /* boot-arg ufswait=1 */
+	bool exynos;                            /* ADT "exynos": Exynos UFS quirks */
+	uint32_t prdt_esz;                      /* PRDT entry size in bytes */
+	vm_offset_t vs_regs;                    /* Exynos vendor HCI, or 0 */
 	int bmajor, cmajor;
 	dev_t bdev;
 	bool ready;
@@ -165,7 +182,7 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
