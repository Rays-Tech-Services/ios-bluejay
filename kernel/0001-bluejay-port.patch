diff --git a/iokit/Kernel/arm/BluejayBattery.h b/iokit/Kernel/arm/BluejayBattery.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/BluejayBattery.h
@@ -0,0 +1,82 @@
+/* Pixel MAX77759 observer. Register provenance: shim/power-usb.h and
+ * docs/network-battery.md. Only address-pointer writes; no charger setup. */
+extern "C" void bluejay_gpio_lock(void);
+extern "C" void bluejay_gpio_unlock(void);
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+static volatile uint32_t *pb_bank;
+static void pb_gpio_func(int pin, uint32_t fn) {
+ pb_bank[0]=(pb_bank[0]&~(0xfu<<(4*pin)))|(fn<<(4*pin));
+ __asm__ volatile("dsb sy" ::: "memory");
+}
+#define PB_BANK pb_bank
+#define PB_SCL 4
+#define PB_SDA 5
+static void pb_delay(void) { delay(10); }
+static void pb_line(int pin, int release) { pb_gpio_func( pin, release ? 0 : 1); pb_delay(); }
+static int pb_get(int pin) { return (pb_bank[1] >> pin) & 1; }
+static int pb_clock(void) {
+ pb_line(PB_SCL,1);
+ for (int i=0;i<100;i++) { if (pb_get(PB_SCL)) return 1; pb_delay(); }
+ return 0;
+}
+static int pb_start(void) {
+ pb_line(PB_SDA,1); if (!pb_clock() || !pb_get(PB_SDA)) return 0;
+ pb_line(PB_SDA,0); pb_line(PB_SCL,0); return 1;
+}
+static void pb_stop(void) { pb_line(PB_SCL,0); pb_line(PB_SDA,0); (void)pb_clock(); pb_line(PB_SDA,1); }
+static int pb_send(uint8_t value) {
+ for (int n=7;n>=0;n--) { pb_line(PB_SDA,(value>>n)&1); if (!pb_clock()) return 0; pb_line(PB_SCL,0); }
+ pb_line(PB_SDA,1); if (!pb_clock()) return 0; int ack=!pb_get(PB_SDA); pb_line(PB_SCL,0); return ack;
+}
+static int pb_recv(uint8_t *value, int last) {
+ uint8_t v=0; pb_line(PB_SDA,1);
+ for (int n=0;n<8;n++) { if (!pb_clock()) return 0; v=(v<<1)|pb_get(PB_SDA); pb_line(PB_SCL,0); }
+ pb_line(PB_SDA,last); if (!pb_clock()) return 0; pb_line(PB_SCL,0); pb_line(PB_SDA,1); *value=v; return 1;
+}
+static int pb_read_once(uint8_t chip,uint8_t reg,uint8_t *out,int len) {
+ bluejay_gpio_lock();
+ uint32_t con=pb_bank[0], dat=pb_bank[1];
+ /* Release first, then preload LOW before enabling either output. */
+ pb_gpio_func(PB_SCL,0); pb_gpio_func(PB_SDA,0);
+ pb_bank[1] = dat & ~((1u<<PB_SCL)|(1u<<PB_SDA));
+ int ok=pb_start() && pb_send(chip<<1) && pb_send(reg) && pb_start() && pb_send((chip<<1)|1);
+ for (int i=0;ok && i<len;i++) ok=pb_recv(out+i,i==len-1);
+ pb_stop();
+ /* Restore only these two pins, including latch before original mux. */
+ uint32_t mask=(1u<<PB_SCL)|(1u<<PB_SDA), cmask=(0xfu<<(4*PB_SCL))|(0xfu<<(4*PB_SDA));
+ pb_bank[1] = (pb_bank[1]&~mask)|(dat&mask);
+ pb_bank[0] = (pb_bank[0]&~cmask)|(con&cmask);
+ bluejay_gpio_unlock(); return ok;
+}
+
+/* Retry a complete transaction, always restoring pins and releasing the lock. */
+static int pb_read(uint8_t chip, uint8_t reg, uint8_t *out, int len) {
+ for (unsigned attempt=0; attempt<3; attempt++) {
+  if (pb_read_once(chip,reg,out,len)) return 1;
+  delay(100);
+ }
+ return 0;
+}
+
+#include "BluejayBatteryData.h"
+static bool bluejay_battery_init(void) {
+ DTEntry node; uint32_t const *q; unsigned sz;
+ if (SecureDTLookupEntry(NULL,"/bluejay",&node)!=kSuccess ||
+     SecureDTGetProperty(node,"qemu",(void const **)&q,&sz)!=kSuccess || sz!=4 || *q) return false;
+ pb_bank=(volatile uint32_t *)ml_io_map(0x10c40000,0x1000);
+ if (!pb_bank) return false;
+ pb_bank+=0x60/4; return true;
+}
+static bool pb_read16(uint8_t reg, unsigned *value) {
+ uint8_t b[2]; if (!pb_read(0x36,reg,b,2)) return false;
+ *value=b[0]|((unsigned)b[1]<<8); return true;
+}
+static bool bluejay_battery_sample(BluejayBatterySample *s, bool *charger_valid) {
+ unsigned id,soc,volts,temp; uint8_t intok=0,details1=0,details2=0;
+ *charger_valid=false;
+ if (!pb_read16(0x21,&id) || id==0 || id==0xffff ||
+     !pb_read16(6,&soc) || !pb_read16(9,&volts) || !pb_read16(8,&temp)) return false;
+ *charger_valid=pb_read(0x69,0xb4,&intok,1) && pb_read(0x69,0xb6,&details1,1) &&
+     pb_read(0x69,0xb7,&details2,1);
+ return bluejay_battery_decode(id,soc,volts,temp,intok,details1,details2,s,*charger_valid);
+}
