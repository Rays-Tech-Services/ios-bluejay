 	if (SecureDTLookupEntry(NULL, "/a40-keys", &node) != kSuccess ||
 	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
 		return a40_platform();  /* A40 without keys (QEMU): never probe sweet's SPMI */
