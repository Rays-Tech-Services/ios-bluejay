+/*
+ * sweet (Pixel 6a fork): polled, transmit-only UART described by the ADT node
+ * "sweet-uart" (reg = absolute physical address): "arm,pl011" under QEMU,
+ * "samsung,exynos4210-uart" for the Pixel 6a's USI serial_0 (32-bit access
+ * only). The firmware's line settings are kept. Used only with boot-arg
+ * sweetuart=1: a Samsung port that ABL left clock-gated can hang the bus, so
+ * the shim adds the flag only when ABL enabled the console.
+ */
+static volatile uint32_t *suart_base;
+static bool suart_samsung;
+
+static unsigned int
+suart_transmit_ready(void)
+{
+	if (suart_samsung) {
+		if (suart_base[0x08 / 4] & 1) {                 /* UFCON: FIFO on */
+			return !(suart_base[0x18 / 4] & (1u << 24));    /* UFSTAT TX full */
+		}
+		return (suart_base[0x10 / 4] & 2) != 0;         /* UTRSTAT TX empty */
+	}
+	return !(suart_base[0x18 / 4] & 0x20);                  /* PL011 FR.TXFF */
+}
+
+static void
+suart_transmit_data(uint8_t c)
+{
+	suart_base[(suart_samsung ? 0x20 : 0x00) / 4] = c;      /* UTXH / DR */
+}
+
+static unsigned int
+suart_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+suart_receive_data(void)
+{
+	return 0;
+}
+
+static void
+suart_init(void)
+{
+	if (!suart_samsung) {
+		suart_base[0x30 / 4] |= 0x101;                  /* PL011 CR: UARTEN | TXE */
+	}
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) sweet_uart_serial_functions =
+{
+	.init = suart_init,
+	.transmit_ready = suart_transmit_ready,
+	.transmit_data = suart_transmit_data,
+	.receive_ready = suart_receive_ready,
+	.receive_data = suart_receive_data,
+	.device = SERIAL_SWEET_UART
+};
+
+static void
+sweet_uart_probe(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	char const *compat;
+	unsigned int size, csize;
+	uint32_t enabled = 0;
+
+	if (!PE_parse_boot_argn("sweetuart", &enabled, sizeof(enabled)) || !enabled ||
+	    SecureDTFindEntry("name", "sweet-uart", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16 ||
+	    SecureDTGetProperty(entry, "compatible", (void const **)&compat, &csize) != kSuccess) {
+		return;
+	}
+	suart_samsung = strncmp(compat, "arm,pl011", csize) != 0;
+	suart_base = (volatile uint32_t *)ml_io_map(reg[0], reg[1]);
+	if (suart_base != NULL) {
+		register_serial_functions(&sweet_uart_serial_functions);
+	}
+}
+
