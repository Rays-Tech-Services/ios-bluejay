+/*
+ * ACPM DVFS from the kernel: the same transport the shim uses for the PMIC
+ * and for the boot-time CPU clocks (shim/shim.c acpm_xfer; mainline
+ * exynos-acpm.c / exynos-acpm-dvfs.c). Channel 0, request {domain, kHz,
+ * 0 = set / 1 = get, ms}; the firmware echoes the sequence number.
+ */
+#define BLUEJAY_APM_SRAM        0x02039000ULL
+#define BLUEJAY_APM_SRAM_SIZE   0x40000
+#define BLUEJAY_ACPM_INITDATA   0xa000
+#define BLUEJAY_AP2APM_MBOX     0x17610000ULL
+#define BLUEJAY_MBOX_INTGR1     0x40
+#define BLUEJAY_ACPM_DVFS_CHAN  0
+
+static inline uint32_t
+apm_rd(volatile uint8_t *base, uint64_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+apm_wr(volatile uint8_t *base, uint64_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+int
+SweetBattery::acpmDvfs(unsigned domain, unsigned khz, unsigned *out)
+{
+	if (fApmMap == NULL || fMboxMap == NULL) {
+		return -1;
+	}
+	volatile uint8_t *sram = (volatile uint8_t *)fApmMap->getVirtualAddress();
+	volatile uint8_t *mbox = (volatile uint8_t *)fMboxMap->getVirtualAddress();
+	uint32_t chan = BLUEJAY_ACPM_DVFS_CHAN;
+	if (apm_rd(sram, BLUEJAY_ACPM_INITDATA + 24) <= chan) {
+		return -2;
+	}
+	uint64_t ch = apm_rd(sram, BLUEJAY_ACPM_INITDATA + 8) + chan * 72;
+	if (ch + 72 > BLUEJAY_APM_SRAM_SIZE || (ch & 3)) {
+		return -3;
+	}
+	uint32_t qlen = apm_rd(sram, ch + 52), mlen = apm_rd(sram, ch + 56);
+	uint64_t txr = apm_rd(sram, ch + 16), txf = apm_rd(sram, ch + 20), txb = apm_rd(sram, ch + 24);
+	uint64_t rxr = apm_rd(sram, ch + 40), rxf = apm_rd(sram, ch + 44), rxb = apm_rd(sram, ch + 48);
+	uint64_t limit = BLUEJAY_APM_SRAM_SIZE;
+	if (qlen < 2 || qlen > 64 || mlen < 16 || mlen > 256 || ch + 72 > limit ||
+	    ((txr | txf | rxr | rxf | txb | rxb | mlen) & 3) ||
+	    txr + 4 > limit || txf + 4 > limit || rxr + 4 > limit || rxf + 4 > limit ||
+	    txb + (uint64_t)qlen * mlen > limit || rxb + (uint64_t)qlen * mlen > limit) {
+		return -3;
+	}
+	uint32_t front = apm_rd(sram, txf);
+	if (front >= qlen || apm_rd(sram, txr) >= qlen) {
+		return -5;
+	}
+	uint32_t next = (front + 1) % qlen;
+	for (int i = 0; apm_rd(sram, txr) == next; i++) {
+		if (i > 100) {
+			return -4;              /* queue full */
+		}
+		IODelay(1000);
+	}
+	fAcpmSeq = (uint8_t)(fAcpmSeq % 63 + 1);
+	uint32_t cmd[4];
+	cmd[0] = (uint32_t)fAcpmSeq << 16 | (domain & 0xfff);
+	cmd[1] = khz;
+	cmd[2] = khz ? 0 : 1;
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	cmd[3] = (uint32_t)(ns / NSEC_PER_MSEC);
+	if (front >= qlen) {
+		return -5;
+	}
+	for (int i = 0; i < 4; i++) {
+		apm_wr(sram, txb + (uint64_t)mlen * front + 4 * i, cmd[i]);
+	}
+	__builtin_arm_dsb(0xf);         /* DSB SY */
+	apm_wr(sram, txf, next);
+	apm_wr(mbox, BLUEJAY_MBOX_INTGR1, 1u << chan);
+	for (int t = 0; t < 2000; t++) {        /* ~100 ms */
+		uint32_t i = apm_rd(sram, rxr), f = apm_rd(sram, rxf);
+		if (i >= qlen || f >= qlen) {
+			return -5;
+		}
+		__builtin_arm_dsb(0xf);
+		bool got = false;
+		uint32_t w1 = 0;
+		for (int n = 0; i != f && i < qlen && n < 64; n++) {
+			uint64_t m = rxb + (uint64_t)mlen * i;
+			if (((apm_rd(sram, m) >> 16) & 0x3f) == fAcpmSeq) {
+				got = true;
+				w1 = apm_rd(sram, m + 4);
+			}
+			i = (i + 1) % qlen;
+		}
+		apm_wr(sram, rxr, f);
+		if (got) {
+			if (out) {
+				*out = w1;
+			}
+			return 0;
+		}
+		IODelay(50);
+	}
+	return -6;                              /* no answer */
+}
+
+void
+SweetBattery::thermalStart(void)
+{
+	int on = 0;
+	if (!fBluejay || !PE_parse_boot_argn("sweetthermal", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	IOMemoryDescriptor *sram = IOMemoryDescriptor::withPhysicalAddress(BLUEJAY_APM_SRAM,
+	    BLUEJAY_APM_SRAM_SIZE, kIODirectionInOut);
+	IOMemoryDescriptor *mbox = IOMemoryDescriptor::withPhysicalAddress(BLUEJAY_AP2APM_MBOX,
+	    0x1000, kIODirectionInOut);
+	if (sram != NULL) {
+		fApmMap = sram->map(kIOMapInhibitCache);
+		sram->release();
+	}
+	if (mbox != NULL) {
+		fMboxMap = mbox->map(kIOMapInhibitCache);
+		mbox->release();
+	}
+	unsigned x1 = 0, a76 = 0;
+	int e = acpmDvfs(BLUEJAY_DVFS_CPUCL2, 0, &x1);
+	if (!e) {
+		e = acpmDvfs(BLUEJAY_DVFS_CPUCL1, 0, &a76);
+	}
+	/* The shim's boot request (shimcpu=1/2) is the full-speed level. */
+	fX1MaxKHz = x1 >= 1000000 && x1 <= 2802000 ? x1 : 2253000;
+	fA76MaxKHz = a76 >= 1000000 && a76 <= 2253000 ? a76 : 2253000;
+	fThermal = e == 0;
+	fThermalDirty = true;
+	fThermalLevel = 0;
+	IOLog("BLUEJAY THERMAL: %s, X1 %u kHz A76 %u kHz (error %d)\n",
+	    fThermal ? "on" : "unavailable", x1, a76, e);
+}
+
+void
+SweetBattery::thermalPoll(bool valid)
+{
+	if (!fThermal) {
+		return;
+	}
+	unsigned next = bluejay_thermal_next(fThermalLevel, valid ? fTemperature : 8001);
+	if (next == fThermalLevel && !fThermalDirty) {
+		return;
+	}
+	BluejayThermalLevel l = bluejay_thermal_clocks(next, fX1MaxKHz, fA76MaxKHz);
+	int e1 = acpmDvfs(BLUEJAY_DVFS_CPUCL2, l.x1_khz, NULL);
+	int e2 = acpmDvfs(BLUEJAY_DVFS_CPUCL1, l.a76_khz, NULL);
+	IOLog("BLUEJAY THERMAL: %d.%02d C level %u -> %u: X1 %u A76 %u kHz (errors %d %d)\n",
+	    fTemperature / 100, (fTemperature < 0 ? -fTemperature : fTemperature) % 100,
+	    fThermalLevel, next, l.x1_khz, l.a76_khz, e1, e2);
+	/* Retry both domains after a partial failure, even if temperature recovers. */
+	fThermalDirty = e1 != 0 || e2 != 0;
+	if (!fThermalDirty) {
+		fThermalLevel = next;
+	}
+}
+
