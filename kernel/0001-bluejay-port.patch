@@ -4,6 +4,10 @@
  * as inputs (gpio-keys pin function 0xf = EINT, DAT still reads the level).
  * Polled every 20 ms from a kernel thread; reported like the SWEET keys:
  * 0 = power (gpa1-7), 1 = volume up (gpa1-5), 2 = volume down (gpa1-6).
+ *
+ * Pixel 6a (and any board with an ADT /gpio-keys node): the same polling for
+ * a table of keys = <u64 DAT register PA, u32 bit, u32 key index>, active low
+ * unless bit 31 of the bit field is set (tools/mkadt.py).
  */
 #include <sys/param.h>
 #include <sys/systm.h>
@@ -24,6 +28,69 @@ int a40_platform(void);
 static vm_offset_t a40_gpa1;
 static int a40_keys_chan;
 
+#define GPIO_KEYS_MAX   8
+static struct {
+	volatile uint32_t *dat;
+	uint32_t bit;
+	bool active_high;
+	int key;
+	int down;
+} gk[GPIO_KEYS_MAX];
+static unsigned int gk_count;
+
+static void
+gpio_keys_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		for (unsigned int i = 0; i < gk_count; i++) {
+			uint32_t dat = *gk[i].dat;
+			int level = (dat >> gk[i].bit) & 1;
+			int down = gk[i].active_high ? level : !level;
+			if (down != gk[i].down) {
+				gk[i].down = down;
+				printf("SWEET GPIO KEYS: key=%d down=%d dat=%#x\n", gk[i].key, down, dat);
+				sweet_hid_key(gk[i].key, down);
+			}
+		}
+		assert_wait_timeout((event_t)&a40_keys_chan, THREAD_UNINT, 20, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+/* Returns 1 when the ADT has a /gpio-keys table (and polling started). */
+static int
+gpio_keys_init(void)
+{
+	DTEntry node;
+	uint8_t const *t;
+	unsigned int size;
+	thread_t th;
+
+	if (SecureDTLookupEntry(NULL, "/gpio-keys", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "keys", (void const **)&t, &size) != kSuccess || size < 16) {
+		return 0;
+	}
+	for (unsigned int off = 0; off + 16 <= size && gk_count < GPIO_KEYS_MAX; off += 16) {
+		uint64_t pa;
+		uint32_t bit, key;
+		memcpy(&pa, t + off, 8);
+		memcpy(&bit, t + off + 8, 4);
+		memcpy(&key, t + off + 12, 4);
+		gk[gk_count].dat = (volatile uint32_t *)(ml_io_map(pa & ~0x3fffULL, 0x4000) + (pa & 0x3fff));
+		gk[gk_count].bit = bit & 31;
+		gk[gk_count].active_high = (bit >> 31) != 0;
+		gk[gk_count].key = (int)key;
+		gk[gk_count].down = 0;
+		printf("SWEET GPIO KEYS: key %u at %#llx bit %u, now %#x\n", key, pa, bit & 31,
+		    *gk[gk_count].dat);
+		gk_count++;
+	}
+	if (kernel_thread_start(gpio_keys_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+	return 1;
+}
+
 static void
 a40_keys_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -51,7 +118,8 @@ a40_platform(void)
 {
 	DTEntry node;
 	return SecureDTLookupEntry(NULL, "/a40-mmc", &node) == kSuccess ||
-	       SecureDTLookupEntry(NULL, "/a40-virtio", &node) == kSuccess;
+	       SecureDTLookupEntry(NULL, "/a40-virtio", &node) == kSuccess ||
+	       SecureDTLookupEntry(NULL, "/bluejay", &node) == kSuccess;
 }
 
 /* A40 diag: A73 cluster clock (CMU_CPUCL0) and measured core frequency. */
@@ -88,6 +156,9 @@ a40_keys_init(void)
