@@ -0,0 +1,24 @@
+/* Read-only MAX77759 sample conversion; units from Google's maxfg_common.h
+ * and charger state definitions. No hardware access or charging control. */
+#ifndef BLUEJAY_BATTERY_DATA_H
+#define BLUEJAY_BATTERY_DATA_H
+struct BluejayBatterySample {
+ unsigned percent, mv; int temperature; bool external, charging, full;
+};
+static bool bluejay_battery_decode(unsigned id, unsigned soc, unsigned volts,
+ unsigned temp, unsigned intok, unsigned details1, unsigned details2,
+ BluejayBatterySample *s, bool charger_valid = true) {
+ if (id==0 || id==0xffff || id>0xffff || soc>100u*256u || volts>0xffff || temp>0xffff) return false;
+ unsigned mv=volts*5u/64u;
+ int tc=((temp&0x8000)?(int)temp-65536:(int)temp)*100/256;
+ if (mv<2800 || mv>4600 || tc < -2000 || tc>8000) return false;
+ s->percent=(soc+128)/256; s->mv=mv; s->temperature=tc;
+ /* Charger failure must not discard valid fuel-gauge data or invent unplugging. */
+ if (!charger_valid) return true;
+ s->external=(intok&0x40)!=0;
+ unsigned state=details1&15;
+ s->charging=s->external && (details2&0x20) && state<=3;
+ s->full=s->external && state==4;
+ return true;
+}
+#endif
diff --git a/iokit/Kernel/arm/BluejayThermal.h b/iokit/Kernel/arm/BluejayThermal.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/BluejayThermal.h
@@ -0,0 +1,52 @@
+/* CPU clock policy from the battery thermistor, shared with host checks. */
+#ifndef BLUEJAY_THERMAL_H
+#define BLUEJAY_THERMAL_H
+
+/* ACPM DVFS domains (mainline google,gs101-acpm.h). */
+#define BLUEJAY_DVFS_CPUCL1     3       /* 2 x Cortex-A76 */
+#define BLUEJAY_DVFS_CPUCL2     4       /* 2 x Cortex-X1 */
+
+struct BluejayThermalLevel {
+	unsigned a76_khz, x1_khz;
+};
+
+/* Level 0 = full speed (X1 at the boot-arg maximum), 1 = warm, 2 = hot. */
+static inline BluejayThermalLevel
+bluejay_thermal_clocks(unsigned level, unsigned x1_max_khz,
+    unsigned a76_max_khz = 2253000u)
+{
+	BluejayThermalLevel l;
+	l.a76_khz = level >= 2 ? 1803000u : 2253000u;
+	l.x1_khz = level >= 2 ? 1803000u : level == 1 ? 2253000u : x1_max_khz;
+	if (l.a76_khz > a76_max_khz) {
+		l.a76_khz = a76_max_khz;
+	}
+	if (l.x1_khz > x1_max_khz) {
+		l.x1_khz = x1_max_khz;
+	}
+	return l;
+}
+
+/*
+ * Battery temperature in 0.01 C. Step up at 40 / 44 C, back down only below
+ * 42 / 38 C so the clocks do not oscillate around one threshold. An invalid
+ * reading (outside -20..80 C) is treated as hot.
+ */
+static inline unsigned
+bluejay_thermal_next(unsigned level, int centi_c)
+{
+	if (centi_c < -2000 || centi_c > 8000 || centi_c >= 4400) {
+		return 2;
+	}
+	if (centi_c >= 4000) {
+		return level >= 2 && centi_c >= 4200 ? 2 : 1;
+	}
+	if (level >= 2) {
+		return centi_c >= 4200 ? 2 : 1;
+	}
+	if (level == 1) {
+		return centi_c >= 3800 ? 1 : 0;
+	}
+	return 0;
+}
+#endif
