+/*
+ * Mask the TE trigger and wait until DECON finishes any transfer in flight,
+ * or release it so the next TE sends the completed frame. Without this the
+ * panel can read the framebuffer while it is half rewritten (tearing).
+ */
+void
+AppleCLCD::holdPanel(bool hold)
+{
+	if (fDecon == NULL) {
+		return;
+	}
+	volatile uint32_t *trig = &fDecon[SWEET_DECON_TRIG_CON / 4];
+	if (!hold) {
+		__builtin_arm_dsb(0xf);       /* DSB SY */
+		*trig = *trig & ~SWEET_DECON_HW_TRIG_MASK;
+		return;
+	}
+	*trig = *trig | SWEET_DECON_HW_TRIG_MASK;
+	__builtin_arm_dsb(0xf);       /* DSB SY */
+	uint64_t t0 = mach_absolute_time(), deadline;
+	nanoseconds_to_absolutetime(SWEET_DECON_IDLE_WAIT_US * NSEC_PER_USEC, &deadline);
+	while (!(fDecon[SWEET_DECON_GLOBAL_CON / 4] & SWEET_DECON_IDLE_STATUS)) {
+		if (mach_absolute_time() - t0 > deadline) {
+			fStatIdleTimeouts++;
+			break;
+		}
+	}
+	fStatIdleWaitAbs += mach_absolute_time() - t0;
+}
+
+/*
+ * One row of a layer into the panel. With the damage shadow, rows equal to
+ * what the panel already shows are skipped: reading cached memory is much
+ * cheaper than writing the write-combined panel memory.
+ */
+void
+AppleCLCD::copyRow(uint32_t py, uint32_t px, const void *src, size_t len)
+{
+	uint64_t off = (uint64_t)py * fRowBytes + (uint64_t)px * 4;
+	fStatRows++;
+	if (fShadow != NULL) {
+		if (fShadowValid && memcmp(fShadow + off, src, len) == 0) {
+			return;
+		}
+		memcpy(fShadow + off, src, len);
+	}
+	memcpy((void *)(fPixels + off), src, len);
+	fStatRowsCopied++;
+}
+
+/* Vsync thread only (all counters are written there, except fStatSwaps). */
+void
+AppleCLCD::logStats(uint64_t now)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(now - fStatLastAbs, &ns);
+	if (ns < 5 * NSEC_PER_SEC) {
+		return;
+	}
+	IOLockLock(fLock);
+	uint64_t swaps = fStatSwaps;
+	fStatSwaps = 0;
+	IOLockUnlock(fLock);
+	uint64_t avgNs = 0, maxNs = 0;
+	if (fStatPresents != 0) {
+		absolutetime_to_nanoseconds(fStatPresentAbs / fStatPresents, &avgNs);
+	}
+	absolutetime_to_nanoseconds(fStatPresentMaxAbs, &maxNs);
+	uint64_t ms = ns / NSEC_PER_MSEC;
+	uint64_t idleNs = 0;
+	if (fStatPresents != 0) {
+		absolutetime_to_nanoseconds(fStatIdleWaitAbs / fStatPresents, &idleNs);
+	}
+	IOLog("SWEET FPS: swaps %llu.%llu/s shown %llu.%llu/s copy avg %llu us max %llu us rows %llu/%llu te wait %llu us timeouts %llu\n",
+	    swaps * 1000 / ms, (swaps * 10000 / ms) % 10,
+	    fStatPresents * 1000 / ms, (fStatPresents * 10000 / ms) % 10,
+	    avgNs / 1000, maxNs / 1000, fStatRowsCopied, fStatRows, idleNs / 1000, fStatIdleTimeouts);
+	fStatIdleWaitAbs = fStatIdleTimeouts = 0;
+	fStatPresents = fStatPresentAbs = fStatPresentMaxAbs = 0;
+	fStatRows = fStatRowsCopied = 0;
+	fStatLastAbs = now;
+}
