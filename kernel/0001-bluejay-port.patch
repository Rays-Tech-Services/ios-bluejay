+/*
+ * sweetfix_posterboard=1 (user-approved test option): PosterBoard (iOS
+ * 16.7.16 20H392) races its own clients. A client asking for the switcher
+ * configuration before the first prewarm finishes makes
+ * -[PBFPosterExtensionDataStore _stateLock_switcherConfiguration] build one
+ * lazily; the prewarm's _stateLock_setupSwitcherConfigurationForFirstTime
+ * then asserts "!_stateLock_switcherConfiguration" (brk #0). The relaunched
+ * process is never prewarmed, so no wallpaper extension runs and every
+ * SpringBoard blur samples an empty wallpaper. The first-time setup rebuilds
+ * the configuration anyway: turn that one CBNZ into a NOP in PosterBoard's
+ * own copy-on-write view of the page, only if the original bytes match.
+ * This clears CS_KILL/CS_HARD for PosterBoard (as a debugger would).
+ * Called by exec with the new task's map switched in.
+ */
+#define SWEET_PB_ASSERT_VA      0x1c1777ab4ULL  /* unslid, cbnz x8, assert */
+#define SWEET_PB_ASSERT_INSN    0xb5003628u
+#define SWEET_ARM64_NOP         0xd503201fu
+extern int cs_allow_invalid(struct proc *p);
+void sweet_exec_fixup(struct proc *p, const char *name, task_t task);
+
+void
+sweet_exec_fixup(struct proc *p, const char *name, task_t task)
+{
+	int on = 0;
+	if (strcmp(name, "PosterBoard") != 0 ||
+	    !PE_parse_boot_argn("sweetfix_posterboard", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr == NULL) {
+		printf("SWEET FIX: PosterBoard has no shared region\n");
+		return;
+	}
+	uint64_t slide = sr->sr_slide;
+	vm_shared_region_deallocate(sr);
+	user_addr_t va = (user_addr_t)(SWEET_PB_ASSERT_VA + slide);
+	uint32_t insn = 0;
+	if (copyin(va, &insn, sizeof(insn)) != 0 || insn != SWEET_PB_ASSERT_INSN) {
+		printf("SWEET FIX: PosterBoard 0x%llx is 0x%x, not the expected build: skipped\n",
+		    (uint64_t)va, insn);
+		return;
+	}
+	if (!cs_allow_invalid(p)) {
+		printf("SWEET FIX: PosterBoard: code-signing policy refused, skipped\n");
+		return;
+	}
+	vm_map_t map = get_task_map(task);
+	vm_map_offset_t page = vm_map_trunc_page(va, vm_map_page_mask(map));
+	vm_map_offset_t end = page + vm_map_page_size(map);
+	kern_return_t kr = vm_map_protect(map, page, end,
+	    VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE | VM_PROT_COPY, FALSE);
+	uint32_t nop = SWEET_ARM64_NOP;
+	int err = kr == KERN_SUCCESS ? copyout(&nop, va, sizeof(nop)) : -1;
+	kern_return_t kr2 = vm_map_protect(map, page, end, VM_PROT_READ | VM_PROT_EXECUTE, FALSE);
+	uint32_t check = 0;
+	(void)copyin(va, &check, sizeof(check));
+	printf("SWEET FIX: PosterBoard first-time setup assert at 0x%llx: protect %d write %d restore %d now 0x%x\n",
+	    (uint64_t)va, kr, err, kr2, check);
+}
