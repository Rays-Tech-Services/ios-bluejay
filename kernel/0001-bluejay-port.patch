+	    SecureDTFindEntry("name", "sweet-uart", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16 ||
+	    SecureDTGetProperty(entry, "compatible", (void const **)&compat, &csize) != kSuccess) {
+		return;
+	}
