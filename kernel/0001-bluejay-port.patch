+	/* Offsets/lengths: DWORDs (UFSHCI), bytes on Exynos (PRDT_BYTE_GRAN). */
+	uint32_t unit = su.exynos ? 1u : 4u;
+	utrd->resp = (512u / unit) << 16 | (512u / unit);
+	uint32_t nprdt = 0;
