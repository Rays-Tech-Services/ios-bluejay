 	ucd->cmd[14] = (uint8_t)(len >> 8);
@@ -177,16 +194,20 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
