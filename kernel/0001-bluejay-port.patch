+
+/*
+ * sweetreboot=1 (bluejay test images): iOS restart and power off both reset
+ * into the bootloader, so the next `fastboot boot` needs no button combo.
+ * Otherwise power off drops PS_HOLD like Pixel's own pixel-reboot driver and
+ * restart is PSCI SYSTEM_RESET, then SWRESET. The default path only parks
+ * the CPU, so PEHaltRestart's 30 s timer panicked "Halt/Restart Timed Out";
+ * if the phone is still running (e.g. USB power holds it up), reset into the
+ * bootloader instead of panicking.
+ * Panics keep the default path (their text stays on the screen).
+ */
+#if defined(SWEET_BOARD_BLUEJAY)
+static void
+bluejay_reset_to_bootloader(void)
+{
+	uint64_t r = bluejay_smc(TENSOR_SMC_PMU_SEC_REG, BLUEJAY_PMU_SYSIP_DAT0,
+	    TENSOR_PMUREG_WRITE, BLUEJAY_REBOOT_BOOTLOADER);
+	bluejay_smc(PSCI_SYSTEM_RESET, 0, 0, 0);
+	IOLog("SWEET: PSCI SYSTEM_RESET returned (mode write %llx)\n", r);
+}
+#endif
+
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+#if defined(SWEET_BOARD_BLUEJAY)
+	int mode = 0;
+	if ((type == kPERestartCPU || type == kPEHaltCPU) &&
+	    PE_parse_boot_argn("sweetreboot", &mode, sizeof(mode)) && mode == 1) {
+		IOLog("SWEET: %s -> reset into the bootloader\n",
+		    type == kPEHaltCPU ? "power off" : "restart");
+		bluejay_reset_to_bootloader();
+	} else if (type == kPEHaltCPU) {
+		uint64_t hold = bluejay_smc(TENSOR_SMC_PMU_SEC_REG, BLUEJAY_PMU_PS_HOLD_CONTROL,
+		    TENSOR_PMUREG_READ, 0);
+		IOLog("SWEET: power off, PS_HOLD_CONTROL %llx\n", hold);
+		if (hold <= 0xffffffffULL && (hold & BLUEJAY_PS_HOLD_DATA)) {
+			bluejay_smc(TENSOR_SMC_PMU_SEC_REG, BLUEJAY_PMU_PS_HOLD_CONTROL,
+			    TENSOR_PMUREG_WRITE, hold & ~(uint64_t)BLUEJAY_PS_HOLD_DATA);
+			IODelay(3 * 1000 * 1000);
+		}
+		IOLog("SWEET: still powered, resetting into the bootloader\n");
+		bluejay_reset_to_bootloader();
+	} else if (type == kPERestartCPU) {
+		IOLog("SWEET: restart -> PSCI SYSTEM_RESET\n");
+		bluejay_smc(PSCI_SYSTEM_RESET, 0, 0, 0);
+		bluejay_smc(TENSOR_SMC_PMU_SEC_REG, BLUEJAY_PMU_SWRESET_SYSTEM,
+		    TENSOR_PMUREG_WRITE, BLUEJAY_SWRESET_TRIGGER);
+		IOLog("SWEET: restart did not reset\n");
+	}
+#endif
+	return IODTPlatformExpert::haltRestart(type);
+}
