+{
+	return enabled && parent == 0 &&
+	       (format == SWEET_FORMAT_RGB10 || format == SWEET_FORMAT_RGB10A8) &&
+	       sweet_surface_is_web_process(process);
+}
+
+/*
+ * WebKit's GPU process falls back to CPU CGBitmapContext buffers when
+ * IOSurfaceCreate fails. Its IOSurface-backed contexts draw through
+ * QuartzCore's accelerated CG queue, which left every traced page tile zero.
+ */
+static inline bool
+sweet_surface_web_cpu(bool enabled, const char *process, unsigned parent)
+{
+	return enabled && parent == 0 && sweet_surface_is_web_process(process);
+}
+
+struct SweetSurfaceBGRALayout {
+	unsigned rowBytes, allocSize;
+};
+
+static inline bool
+sweet_surface_bgra_layout(unsigned width, unsigned height, unsigned pageSize,
+    SweetSurfaceBGRALayout *result)
+{
+	if (!width || !height || width > 16384 || height > 16384 ||
+	    pageSize < 64 || pageSize > 65536 || (pageSize & (pageSize - 1))) {
+		return false;
+	}
+	unsigned row = (width * 4u + 63u) & ~63u;
+	unsigned long long size = (unsigned long long)row * height;
+	size = (size + pageSize - 1) & ~(unsigned long long)(pageSize - 1);
+	if (size > (256u << 20)) {
+		return false;
+	}
+	result->rowBytes = row;
+	result->allocSize = (unsigned)size;
+	return true;
+}
+#endif
diff --git a/iokit/Kernel/arm/SweetSurfaceProbe.h b/iokit/Kernel/arm/SweetSurfaceProbe.h
new file mode 100644
index 0000000..edaa58b
--- /dev/null
+++ b/iokit/Kernel/arm/SweetSurfaceProbe.h
@@ -0,0 +1,46 @@
+/* Bounded, read-only BGRA sampling for the temporary graphics diagnostic.
+ * Counts describe sampled pixels, not a proof that the whole image is blank.
+ * No pixel values or page text are emitted. Integer types come from caller. */
+#ifndef SWEET_SURFACE_PROBE_H
+#define SWEET_SURFACE_PROBE_H
+struct SweetSurfaceProbe {
+	unsigned samples, nonzero, rgb, alpha;
+};
+
+static inline void
+sweet_surface_probe_pixel(const volatile unsigned char *p, SweetSurfaceProbe *r)
+{
+	unsigned rgb = p[0] | p[1] | p[2], alpha = p[3];
+	r->samples++;
+	r->nonzero += (rgb | alpha) != 0;
+	r->rgb += rgb != 0;
+	r->alpha += alpha != 0;
+}
+
+static inline bool
+sweet_surface_probe_bgra(const volatile unsigned char *base, unsigned long long length,
+    unsigned offset, unsigned width, unsigned height, unsigned stride, SweetSurfaceProbe *r)
+{
+	*r = {};
+	if (!base || !width || !height || width > 16384 || height > 16384 ||
+	    stride < width * 4u ||
+	    (unsigned long long)offset + (unsigned long long)(height - 1) * stride +
+	    (unsigned long long)width * 4 > length) {
+		return false;
+	}
+	/* A whole-image grid, plus a denser top strip for plain-text test pages. */
+	for (unsigned gy = 0; gy < 64; gy++) {
+		unsigned y = (height - 1) * gy / 63;
+		for (unsigned gx = 0; gx < 64; gx++) {
+			unsigned x = (width - 1) * gx / 63;
+			sweet_surface_probe_pixel(base + offset + (unsigned long long)y * stride + x * 4, r);
+		}
+	}
+	for (unsigned y = 0; y < height && y < 192; y += 4) {
+		for (unsigned x = 0; x < width; x += 8) {
+			sweet_surface_probe_pixel(base + offset + (unsigned long long)y * stride + x * 4, r);
+		}
+	}
+	return true;
+}
+#endif
diff --git a/iokit/Kernel/arm/SweetUSBNetwork.h b/iokit/Kernel/arm/SweetUSBNetwork.h
new file mode 100644
index 0000000..ed61ae1
--- /dev/null
+++ b/iokit/Kernel/arm/SweetUSBNetwork.h
@@ -0,0 +1,72 @@
+/*
+ * Minimal IOKit discovery adapter for the built-in USB ifnet.
+ * Packet I/O remains entirely in sweet_usb.c. XNU here has no separately
+ * linked IONetworkingFamily: these services publish its discovery shape so
+ * iOS addNetworkInterface / SystemConfiguration can create an Ethernet
+ * service, run DHCP, and install route/DNS state. No user-client ABI is
+ * claimed or implemented. SelfNamed means the BSD interface already exists.
+ * Property consumers: Apple's configd SCNetworkInterface.c.
+ */
+#include <IOKit/IOService.h>
+#include <libkern/c++/OSData.h>
+
+class IOUserNetworkEthernet : public IOService {
+ OSDeclareDefaultStructors(IOUserNetworkEthernet);
+};
+OSDefineMetaClassAndStructors(IOUserNetworkEthernet, IOService);
+class IONetworkInterface : public IOService {
+ OSDeclareDefaultStructors(IONetworkInterface);
+};
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+static IOUserNetworkEthernet *sweet_usb_controller;
+static IONetworkInterface *sweet_usb_interface;
+extern "C" void sweet_usb_publish_interface(const unsigned char *mac);
+extern "C" void sweet_usb_registry_link(int active);
+
+extern "C" void
+sweet_usb_publish_interface(const unsigned char *mac)
+{
+ if (sweet_usb_interface) return;
+ IOService *provider = IOService::getResourceService();
+ IOUserNetworkEthernet *controller = new IOUserNetworkEthernet;
+ IONetworkInterface *interface = new IONetworkInterface;
+ if (!provider || !controller || !interface) goto fail;
+ if (!controller->init() || !interface->init()) goto fail;
+ controller->setName("PixelUSBEthernet");
+ controller->setProperty("IOMACAddress", (void *)mac, 6);
+ controller->setProperty("SelfNamed", true);
+ controller->setProperty("IOBuiltin", false);
+ controller->setProperty("IOLinkStatus", (unsigned long long)1, 32);
+ controller->setProperty("IOLinkSpeed", (unsigned long long)480000000, 64);
+ if (!controller->attach(provider)) goto fail;
+ if (!controller->start(provider)) { controller->detach(provider); goto fail; }
+ interface->setName("en0");
+ interface->setProperty("IOBSDName", "en0");
+ interface->setProperty("IOInterfaceNamePrefix", "en");
+ interface->setProperty("IOInterfaceUnit", (unsigned long long)0, 32);
+ interface->setProperty("IOInterfaceType", (unsigned long long)6, 32);
+ interface->setProperty("IOBuiltin", false);
+ interface->setProperty("IOPrimaryInterface", true);
+ interface->setProperty("IOMACAddress", (void *)mac, 6);
+ if (!interface->attach(controller)) { controller->stop(provider); controller->detach(provider); goto fail; }
+ if (!interface->start(controller)) { interface->detach(controller); controller->stop(provider); controller->detach(provider); goto fail; }
+ sweet_usb_controller = controller;
+ sweet_usb_interface = interface;
+ controller->registerService();
+ interface->registerService();
+ IOLog("SWEET USB: IOKit Ethernet discovery registered for en0 / DHCP\n");
+ return;
+fail:
+ if (interface) interface->release();
+ if (controller) controller->release();
+ IOLog("SWEET USB: IOKit Ethernet discovery failed\n");
+}
+
+extern "C" void
+sweet_usb_registry_link(int active)
+{
+ if (sweet_usb_controller) {
+  sweet_usb_controller->setProperty("IOLinkStatus", (unsigned long long)(active ? 3 : 1), 32);
+ }
+}
