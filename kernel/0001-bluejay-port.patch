+	.init = suart_init,
+	.transmit_ready = suart_transmit_ready,
+	.transmit_data = suart_transmit_data,
+	.receive_ready = suart_receive_ready,
+	.receive_data = suart_receive_data,
+	.device = SERIAL_SWEET_UART
