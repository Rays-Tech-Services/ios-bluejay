diff --git a/meson.build b/meson.build
index 96f8770..b79238e 100644
--- a/meson.build
+++ b/meson.build
@@ -811,6 +811,9 @@ if system_has_kms_drm
       'amdgpu' : _libdrm_checks['amdgpu']['enabled'].to_string('enabled', 'disabled'),
     },
   )
+elif host_machine.system() == 'darwin' and with_gallium_panfrost
+  # sweetgl supplies the libdrm ABI over IOKit in the final iOS dylib.
+  dep_libdrm = declare_dependency()
 else
   # We should prevent libdrm from being available when the target doesn't have it to avoid transitive
   # dependencies (such as vk-runtime) linking to it
diff --git a/src/gallium/drivers/panfrost/pan_bo.c b/src/gallium/drivers/panfrost/pan_bo.c
index 995224a..653c88a 100644
--- a/src/gallium/drivers/panfrost/pan_bo.c
+++ b/src/gallium/drivers/panfrost/pan_bo.c
@@ -330,10 +330,12 @@ panfrost_bo_munmap(struct panfrost_bo *bo)
    if (!bo->ptr.cpu)
       return;
 
+#ifndef __APPLE__
    if (os_munmap((void *)(uintptr_t)bo->ptr.cpu, panfrost_bo_size(bo))) {
       mesa_loge("munmap failed: %s", strerror(errno));
       abort();
    }
+#endif
 
    bo->ptr.cpu = NULL;
 }
diff --git a/src/panfrost/lib/kmod/panfrost_kmod.c b/src/panfrost/lib/kmod/panfrost_kmod.c
index 9b7010d..ef50297 100644
--- a/src/panfrost/lib/kmod/panfrost_kmod.c
+++ b/src/panfrost/lib/kmod/panfrost_kmod.c
@@ -25,6 +25,13 @@
 
 #include "pan_props.h"
 
+#ifdef __APPLE__
+/* sweetgl maps wired IOKit BOs; the fake DRM fd is not mmap-able. */
+void *sweet_drm_bo_map(int fd, uint64_t offset);
+#undef os_mmap
+#define os_mmap(addr, length, prot, flags, fd, offset) sweet_drm_bo_map(fd, offset)
+#endif
+
 /* Maximum kmod BO label length, including NUL-terminator */
 #define PANFROST_BO_LABEL_MAXLEN 4096
 
@@ -898,7 +905,13 @@ panfrost_kmod_perf_thread(void *data)
    /* This is best effort. If we can't make the thread RT because we don't
     * have CAP_SYS_NICE, we keep going.
     */
+#ifdef __APPLE__
+   int ret = pthread_setschedparam(pthread_self(), SCHED_FIFO, &rt_params);
+   if (ret)
+      errno = ret;
+#else
    int ret = sched_setscheduler(0, SCHED_FIFO, &rt_params);
+#endif
    if (ret)
       mesa_logw("Can't make the perfcnt thread RT (err=%d)", errno);
 
